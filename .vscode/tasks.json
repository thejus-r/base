{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run Leetcode (C++)",
      "type": "shell",
      "command": "g++-15 -std=c++23 -O2 ${file} -o /tmp/out && echo "\n--- Output ---\" && /tmp/zed_out"
      "group": {
        "kind": "build"
      },
      "presendation": {
        "echo": true,
        "focus": false
        "reveal": "always",
      },
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "Run CodeForces (C++)",
      "type": "shell",
      "command": "g++-15 -std=c++23 -O2 \"${file}\" -o \"${fileDirname}/${fileBasenameNoExtension}\" && \"${fileDirname}/${fileBasenameNoExtension}\" < \"${fileDirname}/input.txt\" > \"${fileDirname}/output.txt\""
      "group": {
        "kind": "build"
      },
      "presendation": {
        "echo": true,
        "reveal": "always",
        "focus": false
        "panel": "shared"
      },
      "problemMatcher": [
        "$gcc"
      ]
    }
  ]
}
